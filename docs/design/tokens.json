    "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
    "duration": {
      "press": "200ms",
      "state": "200ms",
      "reveal": "400ms",
      "draw": "500ms",
      "count": "500ms"
    },
    "stagger": {
      "default": "50ms",
      "min": "40ms",
      "max": "60ms"
    },
    "reveal": {
      "rise": "12px",
      "from-scale": 0.98,
      "in-view-margin": "-10% 0px",
      "once": true
    },
    "press-scale": 0.98
